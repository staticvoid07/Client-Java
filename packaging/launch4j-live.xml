<launch4jConfig>
  <!--
    Wraps the LAUNCHER, not the client.

    This is the point of the whole arrangement: the exe contains no game code, so
    it never needs rebuilding or re-downloading when the client changes. Players
    keep one shortcut forever and pick up new clients automatically.

    Build:  launch4jc launch4j-live.xml
  -->
  <dontWrapJar>false</dontWrapJar>
  <headerType>gui</headerType>
  <jar>../launcher/build/libs/vortexscape-launcher.jar</jar>
  <outfile>../build/dist/vortexscape.exe</outfile>
  <errTitle>VortexScape</errTitle>
  <downloadUrl>https://www.java.com/download/</downloadUrl>
  <chdir>.</chdir>
  <priority>normal</priority>
  <stayAlive>false</stayAlive>
  <restartOnCrash>false</restartOnCrash>
  <icon>vortexscape.ico</icon>

  <!-- channel, manifest URL, then the client args (portOffset 0 = live) -->
  <cmdLine>live https://github.com/staticvoid07/Client-Java/releases/download/live/manifest.json 10 0 highmem members 32 play.vortexidle.com VortexScape</cmdLine>

  <jre>
    <minVersion>1.8.0</minVersion>
    <requiresJdk>false</requiresJdk>
    <requires64Bit>false</requires64Bit>
    <!--
      Without a cap the JVM sizes max heap at a quarter of physical RAM - 15.6 GB
      on a 62 GB machine - so the client grows until it is the biggest thing on
      the system. Measured at ~4 GB resident after 7 hours. RuneLite, a far
      heavier client, ships with -Xmx768m.
    -->
    <maxHeapSize>2048</maxHeapSize>
    <!--
      G1 does not return committed memory on its own; a client left running
      overnight keeps every byte it ever touched. The periodic GC flags are
      JDK 12+, so IgnoreUnrecognizedVMOptions comes first to keep older JREs
      starting rather than refusing an unknown option.
    -->
    <opt>-XX:+IgnoreUnrecognizedVMOptions</opt>
    <opt>-XX:G1PeriodicGCInterval=60000</opt>
    <opt>-XX:+G1PeriodicGCInvokesConcurrent</opt>
  </jre>

  <versionInfo>
    <fileVersion>1.0.0.0</fileVersion>
    <txtFileVersion>1.0.0</txtFileVersion>
    <fileDescription>VortexScape</fileDescription>
    <copyright>VortexScape</copyright>
    <productVersion>1.0.0.0</productVersion>
    <txtProductVersion>1.0.0</txtProductVersion>
    <productName>VortexScape</productName>
    <internalName>vortexscape</internalName>
    <originalFilename>vortexscape.exe</originalFilename>
  </versionInfo>
</launch4jConfig>
